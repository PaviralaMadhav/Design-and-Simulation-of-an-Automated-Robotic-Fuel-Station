function out = fill_time_pressure(varargin)
% FILL_TIME_PRESSURE  How long does the tank take to fill, and what does the
% fuel-line pressure do meanwhile?  (Same flow/pressure model as the workflow
% animation, but runs instantly and draws the graphs. Plain MATLAB, no toolboxes.)
%
%   fill_time_pressure                                % car, lorry and bike, full tank
%   fill_time_pressure('Vehicle','car','Litres',20)   % 20 L into the car
%   fill_time_pressure('Vehicle','lorry','Fault','overpressure')
%
% OPTIONS
%   'Vehicle'  'car' | 'lorry' | 'bike' | 'all'          (default 'all')
%   'Litres'   litres to dispense (default = full tank, limited to the tank size)
%   'Fault'    'none' | 'leak' | 'overpressure'          (default 'none')
%
% MODEL (same as the workflow animation)
%   Pressure follows the QUANTITY pumped: maximum right after the pump starts (start-up
%   surge), a gradual decline as the dispensed fraction grows, then a steep fall over
%   the last 15 % of the requested litres while the flow tapers (gentle finish).
%   P = P0 + k*Q^2 + surge(t) + head(fraction),  P0 = 0.3 bar
%   Valve: PI + feed-forward flow control, actuator lag 0.5 s
%   Protection: trip above 4.5 bar; leak if P < 70 % of expected for the flow

ip = inputParser;
addParameter(ip,'Vehicle','all');
addParameter(ip,'Litres',[]);
addParameter(ip,'Fault','none');
parse(ip,varargin{:});
Pa = ip.Results;
faultMode = validatestring(lower(char(Pa.Fault)),{'none','leak','overpressure'});

names = {'car','lorry','bike'};  tank = [45 300 12];  rated = [0.8 1.7 0.3];  % L, L, L/s
if strcmpi(char(Pa.Vehicle),'all')
    idx = 1:3;
else
    idx = find(strcmpi(char(Pa.Vehicle),names));
    if isempty(idx), error('Vehicle must be car, lorry, bike or all.'); end
end

col = [0.00 0.45 0.74; 0.85 0.33 0.10; 0.47 0.67 0.19];
Ptrip = 4.5; P0 = 0.3; Pnom = 2.5;
figure('Name','Fill time and pressure','Color','w','Position',[80 60 1250 780]);
ax1 = subplot(2,2,1); hold on; grid on; title('Volume dispensed vs time'); xlabel('time (s)'); ylabel('litres');
ax2 = subplot(2,2,2); hold on; grid on; title('Flow vs time');             xlabel('time (s)'); ylabel('L/s');
ax3 = subplot(2,2,3); hold on; grid on; title('Fuel-line pressure vs time'); xlabel('time (s)'); ylabel('pressure (bar)');
ax4 = subplot(2,2,4); hold on; grid on; title('Pressure vs volume dispensed (% of requested)');          xlabel('% of requested litres'); ylabel('pressure (bar)');
yline(ax3,Ptrip,'k--','trip limit 4.5 bar','LabelHorizontalAlignment','left');

fprintf('\n%-7s %7s %10s %12s %14s %12s   %s\n','Vehicle','Litres','Rated L/s','V/Q only (s)','Model time (s)','Peak (bar)','Result');
out = struct('vehicle',{},'litres',{},'fillTime',{},'peakBar',{},'status',{});
leg = {};
for n = idx
    target = tank(n); if ~isempty(Pa.Litres), target = min(Pa.Litres, tank(n)); end
    r = simulateFill(rated(n), target, faultMode, Pnom, P0, Ptrip);
    c = col(n,:);
    plot(ax1,r.t,r.V,'-','Color',c,'LineWidth',1.8);
    plot(ax2,r.t,r.Q,'-','Color',c,'LineWidth',1.8);
    plot(ax3,r.t,r.P,'-','Color',c,'LineWidth',1.4);
    plot(ax3,r.t,r.Pexp,':','Color',c,'LineWidth',1);
    plot(ax4,100*r.V/target,r.P,'-','Color',c,'LineWidth',1.4);
    leg{end+1} = sprintf('%s (%.0f L, %.0f s)',names{n},target,r.tFill); %#ok<AGROW>
    fprintf('%-7s %7.1f %10.2f %12.1f %14.1f %12.2f   %s\n',names{n},target,rated(n),target/rated(n),r.tFill,r.peak,r.status);
    out(end+1) = struct('vehicle',names{n},'litres',target,'fillTime',r.tFill,'peakBar',r.peak,'status',r.status); %#ok<AGROW>
end
legend(ax1,leg,'Location','northwest'); legend(ax2,leg,'Location','best'); legend(ax3,leg,'Location','east');
ylim(ax3,[0 max(6, 1.1*max([out.peakBar]))]);
legend(ax4,leg,'Location','northwest');
sgtitle(sprintf('Tank fill time and fuel-line pressure  (fault mode: %s)',faultMode));
fprintf('\n');
end

function r = simulateFill(flowRate, target, mode, Pnom, P0, Ptrip)
dt = 0.04; k = (Pnom - P0)/flowRate^2;
rng(7);
litres = 0; u = 0; Q = 0; qInt = 0; tD = 0; ft = NaN; status = 'normal';
t = []; V = []; Qh = []; P = []; Pe = [];
while target - litres > 0.01
    tD = tD + dt;
    frac = litres/target;
    tpr = min(1, max(0, (frac - 0.85)/0.14)); taperS = tpr*tpr*(3 - 2*tpr);
    Qt = flowRate*min(1, tD/0.8)*(1 - 0.85*taperS);        % quick start, full flow, taper at the end
    e = (Qt - Q)/flowRate;
    qInt = max(-1, min(1, qInt + e*dt));
    uCmd = min(1, max(0, Qt/flowRate + 0.8*e + 1.5*qInt));
    u = u + (uCmd - u)*dt/0.5;
    Q = u*flowRate;
    litres = min(target, litres + Q*dt);
    blk = 1; lk = 0;
    if litres >= 0.4*target && ~strcmp(mode,'none')
        if isnan(ft), ft = tD; end
        ramp = min(1,(tD-ft)/1.5);
        if strcmp(mode,'overpressure'), blk = 1 + 2.5*ramp; end
        if strcmp(mode,'leak'), lk = ramp; end
    end
    surge = 0.6*(1 - exp(-tD/0.15))*exp(-tD/1.5);          % start-up surge
    head  = 0.8*(1 - frac);                                 % pressure falls as the quantity pumped grows
    pExp = P0 + k*Q^2 + surge + head;
    p = P0 + blk*k*Q^2*(1 - 0.6*lk) + surge + head + 0.02*randn;
    t(end+1) = tD; V(end+1) = litres; Qh(end+1) = Q; P(end+1) = p; Pe(end+1) = pExp; %#ok<AGROW>
    if p > Ptrip
        status = sprintf('TRIPPED: over-pressure at %.1f s',tD); break;
    end
    if Q > 0.3*flowRate && p < 0.7*pExp
        status = sprintf('TRIPPED: leak detected at %.1f s',tD); break;
    end
end
r = struct('t',t,'V',V,'Q',Qh,'P',P,'Pexp',Pe,'tFill',tD,'peak',max(P),'status',status);
end

%% ##########################################################################
%%  PART 3: MULTI-VEHICLE STATION SIMULATION + PETROL-BUNK OWNER'S EXCEL REPORT
%% ##########################################################################
function out = stationSimulation(varargin)
% STATIONSIMULATION  A continuously running robotic fuel station that uses the ORIGINAL animated
% workflow (flowchart + 3D robot + controller + pressure plot) for every vehicle. Random vehicles
% (cars, lorries, bikes) keep arriving, queue for the single robot bay, and are served one after
% the other in the same window - until the simulated run time is over, the vehicle limit is
% reached, or you close the window. Then the full report is printed in the Command Window and
% written to Excel.
ip = inputParser;
addParameter(ip,'RunMinutes',60);       % simulated run time in minutes in which vehicles arrive (Inf = until you close the window)
addParameter(ip,'Vehicles',Inf);        % optional cap on the number of vehicles
addParameter(ip,'Seed',[]);
addParameter(ip,'Live',true);           % false = same simulation, no drawing (instant)
addParameter(ip,'Speed',3);             % animation speed factor of the workflow (bigger = faster)
addParameter(ip,'FrameSkip',1);         % draw only every Nth step (e.g. 5) for a faster animation
addParameter(ip,'MeanGap',150);         % average seconds between arrivals
addParameter(ip,'SaveGraphs',true);       % save velocity / position / acceleration graphs of every vehicle
addParameter(ip,'GraphFolder','');       % folder for the graphs (default: Fuel_Station_Graphs_<date_time> in the current folder)
addParameter(ip,'MaxLitres',10);         % largest fill requested by any vehicle (small = fast simulation)
addParameter(ip,'PetrolPrice',105);
addParameter(ip,'DieselPrice',92);
addParameter(ip,'PetrolStock',3000);
addParameter(ip,'DieselStock',4000);
addParameter(ip,'WrongFuelChance',0.08);
addParameter(ip,'FaultChance',0.15);
addParameter(ip,'File','');
addParameter(ip,'StationName','Robotic Fuel Station');
parse(ip,varargin{:}); P = ip.Results;
if isempty(P.Seed), rng('shuffle'); else, rng(P.Seed); end
Dur = 60*P.RunMinutes; maxV = P.Vehicles;
if ~P.Live && isinf(Dur) && isinf(maxV), Dur = 3600; fprintf('Live is off and no limit given: running 60 simulated minutes.\n'); end

names = {'car','lorry','bike'}; fuelNames = {'petrol','diesel'};
price = [P.PetrolPrice P.DieselPrice];
catNames = {'Car (petrol)','Car (diesel)','Lorry (diesel)','Bike (petrol)'};
outNames = {'Completed','Refused - wrong fuel','Refused - inlet detection error', ...
            'Emergency stop - leak','Emergency stop - over-pressure','Emergency stop - vehicle moved','Emergency stop - other fault'};
t0 = floor(now) + 8/24;                                  % shift starts 08:00
fmt = @(s) datestr(t0 + s/86400,'HH:MM:SS');
detLabel = @(c) ternary(c > 0, upper(names{max(c,1)}), 'N/A');

% one window for the whole run (the workflow redraws into it for every vehicle)
if P.Live
    figH = figure('Name',P.StationName,'NumberTitle','off','Color','w','Units','pixels','Position',[20 40 1520 900]);
    speed = P.Speed; skip = max(1, round(P.FrameSkip));
else
    figH = figure('Name',P.StationName,'NumberTitle','off','Color','w','Visible','off','Units','pixels','Position',[20 40 1520 900]);
    speed = 1e6; skip = 1e9;
end
fprintf('\n--- %s: simulation running (arrivals for %s) ---\n', P.StationName, ...
    ternary(isinf(Dur),'until you close the window',sprintf('%g simulated min',P.RunMinutes)));

%% ---------------- run: vehicles keep arriving ----------------
gdir = P.GraphFolder;
if isempty(gdir), gdir = fullfile(pwd, ['Fuel_Station_Graphs_' datestr(now,'yyyymmdd_HHMMSS')]); end
if P.SaveGraphs && ~exist(gdir,'dir'), mkdir(gdir); end
R = []; pend = []; gen = 0; lastArr = -Inf; nextArr = rand*20; stopGen = false;
bayFree = 0; busyTime = 0; stopNow = false;
petrolL = 0; dieselL = 0; money = 0; served = 0; refused = 0; stopped = 0; catCount = zeros(1,4); n = 0;
while ~stopNow
    % make sure every vehicle that arrives before this one starts is known (for the queue count)
    while ~stopGen && (isempty(pend) || lastArr <= max(bayFree, pend(1).arrive))
        if gen >= maxV || nextArr > Dur, stopGen = true; break; end
        gen = gen + 1;
        pend = [pend, genVehicle(P, gen, nextArr)]; %#ok<AGROW>
        lastArr = nextArr; nextArr = nextArr + (-log(rand))*P.MeanGap;
    end
    if isempty(pend), break; end
    v = pend(1); pend(1) = []; n = n + 1;
    tStart = max(v.arrive, bayFree);
    nq = sum([pend.arrive] <= tStart);

    % ---- run the ORIGINAL animated workflow for this vehicle ----
    hdr = sprintf('%s  |  clock %s  |  vehicle %d: %s, asks %.0f L %s  |  waiting in queue: %d  |  served %d  refused %d  stopped %d  |  petrol %.0f L  diesel %.0f L  |  sales INR %s', ...
        P.StationName, fmt(tStart), n, v.plate, v.want, fuelNames{v.custFuel}, nq, served, refused, stopped, petrolL, dieselL, addCommas(money));
    fprintf('\n=== Vehicle %d (%s) arrives at %s ===\n', n, v.plate, fmt(v.arrive));
    sv = rng;
    res = robotic_fuel_station_workflow('Arrives',names{v.t},'CarEngine',fuelNames{v.eng},'Fuel',fuelNames{v.custFuel}, ...
        'Litres',v.want,'UnsafeParking',v.unsafe,'Fault',v.fault,'Obstacle',v.obstacle,'VehicleMoves',v.moveMode, ...
        'Calibrated',~v.calFail,'Speed',speed,'FrameSkip',skip,'NoiseSeed',v.noiseSeed,'Header',hdr,'Figure',figH);
    rng(sv);                                             % the workflow reseeds the generator; keep our random stream
    if res.closed, stopNow = true; n = n - 1; break; end

    % ---- what happened ----
    fm = res.faultMsg; remark = 'Normal fill';
    if isempty(fm), oc = 1;
    else
        remark = fm;
        if ~isempty(strfind(fm,'WRONG FUEL')), oc = 2;
        elseif ~isempty(strfind(fm,'Inlet detection error')), oc = 3;
        elseif ~isempty(strfind(fm,'LEAK')), oc = 4;
        elseif ~isempty(strfind(fm,'OVER-PRESSURE')), oc = 5;
        elseif ~isempty(strfind(fm,'VEHICLE MOVED')), oc = 6;
        else, oc = 7;
        end
    end
    litres = res.litres; tSvc = res.simT;
    if res.nRepark > 0, remark = [remark '; repositioned (unsafe parking)']; end
    if res.nReplan > 0, remark = [remark '; obstacle - path re-planned']; end
    tEnd = tStart + tSvc; busyTime = busyTime + tSvc; bayFree = tEnd;
    amount = round(litres*price(v.needFuel)*100)/100;
    if litres <= 0.05, fuelDisp = 0; else, fuelDisp = v.needFuel; end
    if fuelDisp == 1, petrolL = petrolL + litres; elseif fuelDisp == 2, dieselL = dieselL + litres; end
    money = money + amount; catCount(v.cat) = catCount(v.cat) + 1;
    if oc == 1, served = served + 1; elseif oc == 2 || oc == 3, refused = refused + 1; else, stopped = stopped + 1; end
    v.oc = oc; v.tStart = tStart; v.tEnd = tEnd; v.wait = tStart - v.arrive; v.tSvc = tSvc;
    v.litres = litres; v.amount = amount; v.peak = res.peak; v.tFill = res.fillTime; v.remark = remark;
    v.fuelDisp = fuelDisp; v.det = res.detCls; v.f = res.detFrac; v.zone = res.detZone; v.detErr = res.detErr;
