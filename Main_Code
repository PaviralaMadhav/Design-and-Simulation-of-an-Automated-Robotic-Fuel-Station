function v = genVehicle(P, id, arr)
% one random arrival (the station is NOT told the type - the workflow detects it)
letters = 'ABCDEFGHJKLMNPRSTUVWXYZ';
u = rand;
if u < 0.50, t = 1; elseif u < 0.80, t = 3; else, t = 2; end          % 50 % cars, 30 % bikes, 20 % lorries
eng = 1 + (rand < 0.5);                                               % car engine: 1 petrol, 2 diesel
names = {'car','lorry','bike'};
V = vehicleDef(names{t}, eng);
v.id = sprintf('V%02d',id);
v.plate = sprintf('AP%02d %s%s %04d', randi(39), letters(randi(numel(letters))), letters(randi(numel(letters))), randi(9999));
v.t = t; v.V = V; v.eng = eng; v.needFuel = V.fuel;
v.custFuel = V.fuel; if rand < P.WrongFuelChance, v.custFuel = 3 - V.fuel; end
lvl = 0.05 + 0.55*rand; space = V.tank*(1 - lvl);                     % tank 5..60 % full on arrival
if rand < 0.30, want = space; else, want = space*(0.30 + 0.70*rand); end
v.level = 100*lvl; v.want = min(space, max(2, round(want*2)/2));
v.want = max(1, min(v.want, P.MaxLitres));                           % keep fills small so the simulation is fast
v.arrive = arr;
v.calFail = rand < 0.03;                                              % camera not calibrated -> inlet detection error
v.unsafe = rand < 0.25; v.obstacle = rand < 0.10;
v.fault = 'none'; v.moveMode = 'none';
if v.custFuel == v.needFuel && ~v.calFail && rand < P.FaultChance
    k = randi(3);
    if k == 1, v.fault = 'leak'; elseif k == 2, v.fault = 'overpressure'; else, v.moveMode = 'fuelling'; end
end
v.noiseSeed = randi(1e6);
if t == 1, v.cat = eng; elseif t == 2, v.cat = 3; else, v.cat = 4; end
% result fields (filled in when the vehicle is served) - same field set for every vehicle
v.oc = 0; v.tStart = 0; v.tEnd = 0; v.wait = 0; v.tSvc = 0; v.litres = 0; v.amount = 0; v.peak = 0;
v.tFill = 0; v.remark = ''; v.fuelDisp = 0; v.det = 0; v.f = NaN; v.zone = ''; v.detErr = NaN;
v.repark = false; v.replan = false; v.motion = []; v.tFS = NaN; v.tFE = NaN; v.graph = '';
end

function r = ternary(c, a, b)
if c, r = a; else, r = b; end
end

function printTable(titleStr, C)
% prints a cell array as an aligned text table in the Command Window
[nr,nc] = size(C); S = cell(nr,nc); w = zeros(1,nc);
for i = 1:nr
    for j = 1:nc
        x = C{i,j};
        if ischar(x), s = x; elseif isempty(x), s = ''; else, s = sprintf('%g',x); end
        if numel(s) > 70, s = [s(1:67) '...']; end
        S{i,j} = s; w(j) = max(w(j), numel(s));
    end
end
fprintf('\n%s\n', titleStr);
for i = 1:nr
    line = '';
    for j = 1:nc, line = [line sprintf('%-*s  ', w(j), S{i,j})]; end %#ok<AGROW>
    fprintf('%s\n', deblank(line));
    if i == 1, fprintf('%s\n', repmat('-', 1, min(numel(line), 200))); end
end
end

function [V,A] = derivs(X, t)
% velocity and acceleration of every column of X (sampled at times t)
V = zeros(size(X)); A = zeros(size(X));
for c = 1:size(X,2)
    V(:,c) = gradient(X(:,c), t); A(:,c) = gradient(V(:,c), t);
end
end

function st = motionStats(M)
st = struct('dur',0,'path',0,'vTip',0,'aTip',0,'vGantry',0,'vShoulder',0,'vElbow',0,'vVeh',0);
if isempty(M) || size(M,1) < 5, return; end
t = M(:,1);
[vt,at] = derivs(M(:,11:13), t); [vv,~] = derivs(M(:,14), t);
st.dur = t(end) - t(1);
st.path = sum(sqrt(sum(diff(M(:,11:13)).^2, 2)));
st.vTip = max(sqrt(sum(vt.^2, 2))); st.aTip = max(sqrt(sum(at.^2, 2)));
st.vGantry = max(abs(M(:,5)));
st.vShoulder = max(abs(rad2deg(M(:,6)))); st.vElbow = max(abs(rad2deg(M(:,7))));
st.vVeh = max(abs(vv));
end

function file = saveMotionGraph(v, gdir, n, outName)
% position / velocity / acceleration graph of one vehicle (vehicle, gantry, joints, tool tip)
file = ''; M = v.motion;
if isempty(M) || size(M,1) < 5, return; end
t = M(:,1);
[vv,av] = derivs(M(:,14), t); [vt,at] = derivs(M(:,11:13), t);
fg = figure('Visible','off','Color','w','Position',[40 40 1500 1000]);
cols = {'Position','Velocity','Acceleration'};
% row 1: vehicle
motionAx(fg,1,cols{1},'Vehicle X (m)',t,M(:,14),{},v);
motionAx(fg,2,cols{2},'(m/s)',t,vv,{},v);
motionAx(fg,3,cols{3},'(m/s^2)',t,av,{},v);
% row 2: gantry carriage
motionAx(fg,4,'','Gantry carriage q1 (m)',t,M(:,2),{},v);
motionAx(fg,5,'','(m/s)',t,M(:,5),{},v);
motionAx(fg,6,'','(m/s^2)',t,M(:,8),{},v);
% row 3: shoulder + elbow
motionAx(fg,7,'','Shoulder / elbow (deg)',t,rad2deg(M(:,3:4)),{'shoulder q2','elbow q3'},v);
motionAx(fg,8,'','(deg/s)',t,rad2deg(M(:,6:7)),{'shoulder','elbow'},v);
motionAx(fg,9,'','(deg/s^2)',t,rad2deg(M(:,9:10)),{'shoulder','elbow'},v);
% row 4: tool tip
motionAx(fg,10,'','Tool tip (m)',t,M(:,11:13),{'x','y','z'},v);
motionAx(fg,11,'','(m/s)',t,[vt sqrt(sum(vt.^2,2))],{'vx','vy','vz','speed'},v);
motionAx(fg,12,'','(m/s^2)',t,[at sqrt(sum(at.^2,2))],{'ax','ay','az','|a|'},v);
for k = 10:12, xlabel(subplot(4,3,k),'time (s)'); end
sgtitle(sprintf('Vehicle %d  %s  (%s)  -  %s   |   dashed lines = fuelling start / end', n, v.plate, outName, ternary(v.t==1,'CAR',ternary(v.t==2,'LORRY','BIKE'))), 'FontWeight','bold','Interpreter','none');
file = fullfile(gdir, sprintf('Vehicle_%02d_%s.png', n, strrep(v.plate,' ','_')));
try, exportgraphics(fg, file, 'Resolution', 110); catch, saveas(fg, file); end
close(fg);
end

function motionAx(fg, k, ttl, ylab, t, Y, leg, v)
ax = subplot(4,3,k,'Parent',fg); hold(ax,'on'); grid(ax,'on'); box(ax,'on');
plot(ax, t, Y, 'LineWidth', 1.2);
if ~isempty(ttl), title(ax, ttl); end
ylabel(ax, ylab); xlim(ax, [t(1) t(end)]);
if ~isnan(v.tFS), xline(ax, v.tFS, 'k--'); end
if ~isnan(v.tFE), xline(ax, v.tFE, 'k--'); end
if ~isempty(leg), legend(ax, leg, 'Location','best','FontSize',7); end
end

function saveMotionOverview(R, gdir)
% one figure comparing the motion of all vehicles
N = numel(R); fg = figure('Visible','off','Color','w','Position',[40 40 1400 900]);
a1 = subplot(2,2,1,'Parent',fg); hold(a1,'on'); grid(a1,'on'); title(a1,'Tool-tip speed - all vehicles'); xlabel(a1,'time since start of vehicle (s)'); ylabel(a1,'m/s');
a2 = subplot(2,2,2,'Parent',fg); hold(a2,'on'); grid(a2,'on'); title(a2,'Vehicle speed - all vehicles'); xlabel(a2,'time since start of vehicle (s)'); ylabel(a2,'m/s');
vT = zeros(1,N); aT = zeros(1,N); ids = cell(1,N); used = false(1,N);
for k = 1:N
    M = R(k).motion; ids{k} = R(k).id;
    if isempty(M) || size(M,1) < 5, continue; end
    used(k) = true; t = M(:,1) - M(1,1);
    [vt,at] = derivs(M(:,11:13), M(:,1)); [vv,~] = derivs(M(:,14), M(:,1));
    plot(a1, t, sqrt(sum(vt.^2,2))); plot(a2, t, abs(vv));
    vT(k) = max(sqrt(sum(vt.^2,2))); aT(k) = max(sqrt(sum(at.^2,2)));
end
if N <= 12, legend(a1, ids(used), 'Location','best','FontSize',7); end
a3 = subplot(2,2,3,'Parent',fg); bar(a3, 1:N, vT, 'FaceColor',[0.30 0.50 0.80]); grid(a3,'on');
title(a3,'Peak tool-tip speed per vehicle'); xlabel(a3,'vehicle no.'); ylabel(a3,'m/s');
a4 = subplot(2,2,4,'Parent',fg); bar(a4, 1:N, aT, 'FaceColor',[0.85 0.45 0.20]); grid(a4,'on');
title(a4,'Peak tool-tip acceleration per vehicle'); xlabel(a4,'vehicle no.'); ylabel(a4,'m/s^2');
sgtitle('Motion overview - all vehicles','FontWeight','bold');
file = fullfile(gdir,'All_Vehicles_Overview.png');
try, exportgraphics(fg, file, 'Resolution', 110); catch, saveas(fg, file); end
close(fg);
end


function m = safeMean(x)
