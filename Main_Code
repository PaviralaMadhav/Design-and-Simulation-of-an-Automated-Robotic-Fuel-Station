function hp = arrowHead(ax, x1, y1, x2, y2, col)
v = [x2-x1, y2-y1]; v = v/norm(v); n = [-v(2) v(1)]; s = 0.17;
P1 = [x2 y2]; P2 = P1 - s*v + 0.45*s*n; P3 = P1 - s*v - 0.45*s*n;
hp = patch('Parent',ax,'XData',[P1(1) P2(1) P3(1)],'YData',[P1(2) P2(2) P3(2)], ...
    'FaceColor',col,'EdgeColor',col);
end

function [cls, zone] = classifyVehicle(f)
% f = position of the fuel inlet along the body, 0 = rear end ... 1 = front end
% rear = CAR, middle = LORRY, front = BIKE
if f < 0.35
    cls = 1; zone = 'rear';
elseif f <= 0.65
    cls = 2; zone = 'middle';
else
    cls = 3; zone = 'front';
end
end

function C = bodyCorners(V, pose)
% world x-y corners of every body box (used for the LiDAR outline)
C = zeros(0,2);
for b = 1:size(V.boxes,1)
    Vw = boxWorld(V.boxes(b,1:6), pose);
    C = [C; Vw(:,1:2)]; %#ok<AGROW>
end
end

function classifyTest(N)
% Headless test: how reliably is the vehicle type found from the inlet position?
if nargin < 1 || isempty(N), N = 300; end
rng(11); names = {'car','lorry','bike'}; conf = zeros(3,3); fr = cell(1,3);
for n = 1:N
    t = randi(3); Vt = vehicleDef(names{t},1);
    pose = [Vt.ideal(1) + (rand*0.25 - 0.10), Vt.ideal(2) + (rand*0.35 - 0.10), deg2rad(rand*12 - 6)];
    yawM = pose(3) + deg2rad(0.4)*randn; hh = [cos(yawM) sin(yawM)];
    sp = bodyCorners(Vt,pose)*hh';
    sRearM = min(sp) + 0.02*randn; sFrontM = max(sp) + 0.02*randn;
    inl = pose(1:2) + 0.001*randn(1,2);                  % inlet after the < 1 mm detection gate
    f = (inl*hh' - sRearM)/(sFrontM - sRearM);
    c = classifyVehicle(f);
    conf(t,c) = conf(t,c) + 1; fr{t}(end+1) = f; %#ok<AGROW>
end
fprintf('\nVehicle type from the inlet position (%d random arrivals, random parking and sensor noise)\n\n', N);
fprintf('%-14s %8s %8s %8s   %-22s %s\n','arrived \ found','car','lorry','bike','inlet position (0=rear..1=front)','accuracy');
for t = 1:3
    if isempty(fr{t}), continue; end
    fprintf('%-14s %8d %8d %8d   %.2f (%.2f .. %.2f)        %5.1f %%\n', names{t}, conf(t,:), ...
        mean(fr{t}), min(fr{t}), max(fr{t}), 100*conf(t,t)/sum(conf(t,:)));
end
fprintf('\nDecision rule: position < 0.35 -> car (rear), 0.35..0.65 -> lorry (middle), > 0.65 -> bike (front).\nOverall accuracy: %.1f %%\n\n', 100*trace(conf)/sum(conf(:)));
end

