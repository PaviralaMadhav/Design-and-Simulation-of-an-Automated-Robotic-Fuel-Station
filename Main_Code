function [wx,wy] = l2w(pose, lx, ly)
wx = pose(1) + lx*cos(pose(3)) - ly*sin(pose(3));
wy = pose(2) + lx*sin(pose(3)) + ly*cos(pose(3));
end

function Vw = boxWorld(b, pose)
% b = [x0 x1 y0 y1 z0 z1] in the vehicle frame, pose = [x y yaw]
x0=b(1); x1=b(2); y0=b(3); y1=b(4); z0=b(5); z1=b(6);
C = [x0 y0 z0; x1 y0 z0; x1 y1 z0; x0 y1 z0; x0 y0 z1; x1 y0 z1; x1 y1 z1; x0 y1 z1];
c = cos(pose(3)); s = sin(pose(3));
Vw = [pose(1) + C(:,1)*c - C(:,2)*s, pose(2) + C(:,1)*s + C(:,2)*c, C(:,3)];
end

function Fv = flapVerts(pose, zc, a)
% flap on the vehicle side face (y = 0), hinged at its rear edge
P = [-0.12 0 zc-0.1; -0.12+0.24*cos(a) -0.24*sin(a) zc-0.1; ...
     -0.12+0.24*cos(a) -0.24*sin(a) zc+0.1; -0.12 0 zc+0.1];
c = cos(pose(3)); s = sin(pose(3));
Fv = [pose(1) + P(:,1)*c - P(:,2)*s, pose(2) + P(:,1)*s + P(:,2)*c, P(:,3)];
end

function hit = pointInBox(p, b, m)
if isempty(b), hit = false; return; end
hit = p(1)>=b(1)-m && p(1)<=b(2)+m && p(2)>=b(3)-m && p(2)<=b(4)+m && p(3)>=b(5)-m && p(3)<=b(6)+m;
end

