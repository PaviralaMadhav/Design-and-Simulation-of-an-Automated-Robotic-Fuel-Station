function out = robotic_fuel_station_complete(action, varargin)
% ROBOTIC_FUEL_STATION_COMPLETE  Everything in ONE file (plain MATLAB, no Simulink).
%
%   robotic_fuel_station_complete('animate', ...)   animated workflow (flowchart + 3D robot,
%                                                   pressure plot, fault handling)
%   robotic_fuel_station_complete('graphs', ...)    fill time + pressure graphs, instant
%
% Calling it with no arguments, or with options only, starts the animation:
%   robotic_fuel_station_complete('Fuel','diesel','Litres',30)
%
% The vehicle type is NEVER given to the station: it detects the type from where the fuel
% inlet sits along the body (rear = CAR, middle = LORRY, front = BIKE).
%
% ANIMATION EXAMPLES
%   robotic_fuel_station_complete('animate')                      % a random vehicle arrives
%   robotic_fuel_station_complete('animate','Fuel','diesel','Litres',30)
%   robotic_fuel_station_complete('animate','Fault','overpressure')
%   robotic_fuel_station_complete('animate','Calibrated',false)   % camera error too big -> inlet NOT opened
%   options: 'Fuel' petrol|diesel (customer), 'Litres', 'UnsafeParking' true|false,
%            'Fault' false|'leak'|'overpressure', 'Obstacle' true|false,
%            'VehicleMoves' false|'approach'|'fuelling',
%            'MaxDetectError' (mm, default 1), 'CameraNoise' (mm, default 3),
%            'Calibrated' true|false, 'Speed'
%   TESTING ONLY (the station is not told these): 'Arrives' random|car|lorry|bike,
%            'Seed' (repeat a random arrival), 'CarEngine' petrol|diesel (what an arriving car takes)
%
% DETECTION TEST (no graphics): how reliably is the vehicle type found from the inlet position?
%   robotic_fuel_station_complete('classify')        % 300 random arrivals
%   robotic_fuel_station_complete('classify',1000)
%
% GRAPH EXAMPLES  (fill time, pressure vs time, pressure vs % of litres)
%   robotic_fuel_station_complete('graphs')                          % car, lorry, bike, full tanks
%   robotic_fuel_station_complete('graphs','Vehicle','car','Litres',20)
%   robotic_fuel_station_complete('graphs','Vehicle','lorry','Fault','overpressure')
%   options: 'Vehicle' car|lorry|bike|all, 'Litres', 'Fault' none|leak|overpressure
%
% CONTINUOUS MULTI-VEHICLE STATION (uses the animated workflow above for EVERY vehicle) + OWNER'S REPORT
%   robotic_fuel_station_complete('station')                          % vehicles keep arriving for 60 simulated minutes
%   robotic_fuel_station_complete('station','Vehicles',10)            % 10 random vehicles
%   robotic_fuel_station_complete('station','RunMinutes',Inf)         % runs until YOU close the window
%   robotic_fuel_station_complete('station','Speed',20,'FrameSkip',4) % FAST animation
%   robotic_fuel_station_complete('station','Live',false)             % same simulation, no drawing (instant)
%   options: 'RunMinutes' (60), 'Vehicles' (cap, default Inf), 'Speed' (3, bigger = faster), 'FrameSkip' (1),
%            'MaxLitres' (10 = biggest fill per vehicle), 'MeanGap' (150 s between arrivals), 'Seed', 'PetrolPrice' (105), 'DieselPrice' (92),
%            'PetrolStock' (3000 L), 'DieselStock' (4000 L), 'WrongFuelChance' (0.08), 'FaultChance' (0.15),
%            'File', 'StationName'
%   Velocity / position / acceleration graphs: one PNG per vehicle + overview + motion_data.mat are saved in
%   'GraphFolder' (default Fuel_Station_Graphs_<date_time>); switch off with 'SaveGraphs',false.
%   Closing the window stops the run and still prints/saves the full report (Command Window + Excel).
%
% Close the figure window to stop the animation.

if nargin < 1, action = 'animate'; varargin = {}; end
known = {'animate','run','workflow','graphs','graph','fill','pressure','classify','detect','station','fleet','report'};
if ~any(strcmpi(char(action), known))
    % called with options only, e.g. robotic_fuel_station_complete('Fuel','diesel','Litres',30)
    varargin = [{action}, varargin];
    action = 'animate';
end
switch lower(action)
    case {'animate','run','workflow'}
        robotic_fuel_station_workflow(varargin{:});
    case {'graphs','graph','fill','pressure'}
        if nargout > 0, out = fill_time_pressure(varargin{:}); else, fill_time_pressure(varargin{:}); end
    case {'classify','detect'}
        classifyTest(varargin{:});
    case {'station','fleet','report'}
        if nargout > 0, out = stationSimulation(varargin{:}); else, stationSimulation(varargin{:}); end
    otherwise
        error('Unknown action "%s". Use ''animate'', ''graphs'' or ''classify''.', action);
end
end

%% ##########################################################################
%%  PART 1: ANIMATED WORKFLOW (flowchart, 3D robot, pressure, faults)
%% ##########################################################################
function res = robotic_fuel_station_workflow(varargin)
% ROBOTIC_FUEL_STATION_WORKFLOW
% Animated robotic fuel station that follows this exact workflow:
%
%   VEHICLE ARRIVES -> Vehicle detection -> Vehicle positioning -> Is position safe?
%     NO  -> Reposition (back to positioning)        YES -> Detect fuel inlet
%   -> Check fuel flap -> Calculate target -> Inverse Kinematics -> Collision Checking
%   -> Trajectory Planning -> Dynamics + Controller -> Move Robot -> Alignment
%   -> Nozzle Insertion -> Fuel Dispensing
%        Normal operation: Stop at target -> Remove nozzle -> Return Home -> COMPLETE
%        Fault detected  : Emergency stop -> Fuel OFF
%
% The left panel is the live flowchart (the active block lights up), the right
% panel is the 3D robot / vehicle animation, with a controller tracking plot and
% a status panel (fuel gauge, messages). No Simulink needed - plain MATLAB only.
%
% VEHICLE TYPE IS DETECTED, NOT GIVEN: after the inlet is located, its position along the
%   body (measured from the LiDAR outline) decides the type: rear = CAR, middle = LORRY,
%   front = BIKE. The type then selects the flap/cap/tank/flow profile.
% INLET DETECTION GATE: the camera averages frames until the detected error (estimated
%   inlet vs true inlet) is below 'MaxDetectError' (default 1 mm). The error is shown in the
%   status panel, a banner and the Command Window. If it cannot get below the limit, the
%   inlet/flap is NOT opened and the Fault branch runs.
%
% OPTIONS (name-value pairs)
%   'Arrives'       TESTING ONLY: 'random' | 'car' | 'lorry' | 'bike' - what the simulator sends
%                   in. The station is NOT told; it must detect the type.   (default 'random')
%   'Seed'          integer to repeat the same random arrival               (default [])
%   'MaxDetectError' detection error limit in mm                            (default 1)
%   'CameraNoise'   per-axis noise of one camera frame in mm                (default 3)
%   'Calibrated'    false = camera bias is not removed -> error too big -> inlet NOT opened (default true)
%   'Fuel'          'petrol' | 'diesel'  (customer input)    (default 'petrol')
%   'CarEngine'     'petrol' | 'diesel'  (what an arriving CAR takes, testing only) (default 'petrol')
%   'Litres'        litres requested                         (default 10)
%   'UnsafeParking' true = parks badly first -> shows NO path (default true)
%   'Fault'         false | 'leak' | 'overpressure'  (true = 'leak')  (default false)
%                   leak: line pressure falls below expected for the flow
%                   overpressure: nozzle/hose blockage -> pressure rises above the trip limit
%   'Obstacle'      true = puts a cart in the path -> collision replan (default false)
%   'VehicleMoves'  false | 'approach' | 'fuelling' (true = 'fuelling')      (default false)
%                   the vehicle creeps forward (driver releases the brake) while the arm
%                   approaches / while fuel is pumping. The VEHICLE MOTION MONITOR compares the
%                   vehicle pose with the pose measured when the inlet was located; more than
%                   15 mm or 1 deg of movement -> Fault branch (Emergency stop, Fuel OFF).
%   'Speed'         animation speed factor                   (default 3)
%
% FUEL LINE PRESSURE (Fuel Dispensing block): the pressure follows the quantity pumped.
%   - start-up surge: pressure jumps to its MAXIMUM right after the pump starts
%   - it then declines gradually as the dispensed fraction grows
%   - over the last 15 % of the requested litres the flow tapers, so the pressure falls
%     steeply and the fill finishes gently (like a real dispenser's slow-fill).
%   P = P0 + k*Q^2 + surge(t) + head(fraction). Trip above 4.5 bar; leak detected if the
%   pressure is below 70 % of expected. Asking for more than the tank holds shows the
%   nozzle auto shut-off (back-pressure spike) at the end.
%
% Try:  'Fuel','diesel' with a petrol car  -> WRONG FUEL, refused, fault branch.
%       Press the red EMERGENCY STOP button any time -> fault branch.

%% ===================== inputs =====================
ip = inputParser;
addParameter(ip,'Vehicle','');           % old name, treated as 'Arrives' (the station is still NOT told)
addParameter(ip,'Arrives','random');
addParameter(ip,'Seed',[]);
addParameter(ip,'MaxDetectError',1);
addParameter(ip,'CameraNoise',3);
addParameter(ip,'Calibrated',true);
addParameter(ip,'Fuel','petrol');
addParameter(ip,'CarEngine','petrol');
addParameter(ip,'Litres',10);
addParameter(ip,'UnsafeParking',true);
addParameter(ip,'Fault',false);
addParameter(ip,'Obstacle',false);
addParameter(ip,'VehicleMoves',false);
addParameter(ip,'Speed',3);
addParameter(ip,'FrameSkip',1);        % draw only every Nth step (used by the multi-vehicle station)
addParameter(ip,'Figure',[]);          % reuse this figure window (used by the multi-vehicle station)
addParameter(ip,'NoiseSeed',7);        % seed of the sensor noise
addParameter(ip,'Header','');          % text line shown at the top of the window
parse(ip,varargin{:});
P = ip.Results;
arr = char(P.Arrives);
if ~isempty(char(P.Vehicle))
    arr = char(P.Vehicle);
    fprintf('Note: the simulator sends in a %s, but the station is NOT told - it detects the type itself.\n', arr);
end
if strcmpi(arr,'random')
    if isempty(P.Seed), rng('shuffle'); else, rng(P.Seed); end
    pickList = {'car','lorry','bike'}; vname = pickList{randi(3)};
else
    vname = validatestring(arr,{'car','lorry','bike'});
end
fuelReq = find(strcmpi(char(P.Fuel),{'petrol','diesel'}));
carEng  = find(strcmpi(char(P.CarEngine),{'petrol','diesel'}));
if isempty(fuelReq), error('Fuel must be ''petrol'' or ''diesel''.'); end
if isempty(carEng),  error('CarEngine must be ''petrol'' or ''diesel''.'); end
fm = P.Fault;
if islogical(fm) || isnumeric(fm)
    if fm, faultMode = 'leak'; else, faultMode = 'none'; end
else
    faultMode = validatestring(lower(char(fm)),{'none','leak','overpressure'});
end
vm = P.VehicleMoves;
if islogical(vm) || isnumeric(vm)
    if vm, moveMode = 'fuelling'; else, moveMode = 'none'; end
else
    moveMode = validatestring(lower(char(vm)),{'none','approach','fuelling'});
end
V = vehicleDef(vname, carEng);
fuelNames = {'PETROL','DIESEL'};
rng(P.NoiseSeed);
res = struct('closed',true);               % result for the multi-vehicle station (completed at the end)
motionLog = zeros(0,14); lastAcc = [0 0 0];   % [t q1 q2 q3 qd1 qd2 qd3 qdd1 qdd2 qdd3 tipX tipY tipZ vehicleX]
faultMsg = ''; peakP = 0; nRepark = 0; nReplan = 0; wasClosed = false; frameCount = 0;

%% ===================== constants / shared state =====================
L1 = 0.65; L2 = 0.65; z0 = 0.6;            % arm geometry (also inside ik3/fk3)
homePos = [0.5 0.35 0.9];
dt = 0.04; Kp = 100; Kd = 15;              % sim step, PD gains (wn = 10 rad/s)
toolCol   = [0.55 0.55 0.55; 0.90 0.20 0.20; 0.10 0.70 0.20; 0.10 0.35 0.90];
toolNames = {'none','press','cap gripper','nozzle'};
calibBias = [0.006 -0.004 0.005];          % camera calibration error (m)
ideal = V.ideal;
if P.UnsafeParking
    park = [ideal(1)+0.12, ideal(2)+0.22, deg2rad(6)];
else
    park = [ideal(1)+0.07, ideal(2)-0.03, deg2rad(1.5)];
end
repark = [ideal(1)+0.04, ideal(2)+0.02, deg2rad(1.0)];
pose = [park(1)-8, park(2), 0];            % [x y yaw] of the vehicle
targetLitres = P.Litres;                   % limited to the tank size once the type is detected
flowRate = 0.8;                            % replaced by the detected profile's rated flow
detCls = 0; detName = ''; detTitle = 'detecting...'; detFrac = NaN; detZone = ''; labelFuel = 0;
detErrShow = NaN;                          % inlet detection error shown in the output (mm)
Vd = struct('title','?','dirType','side','flap','none','tank',inf,'flow',0.8,'fuel',NaN);   % DETECTED profile

q = ik3(homePos); qd = [0 0 0]; qRef = q;
tool = 0; ndir = [0 1 0]; ndirGoal = [0 1 0];
wrist = 0; flapAng = 0; capState = 1;      % cap: 1 on vehicle, 2 gripper, 3 tray
litres = 0; flowing = false; valveOpen = false; seated = false;
estopReq = false; inFault = false; curNode = ''; simT = 0; tClock = tic;
est = struct('inlet',[0 0 0],'dir',[0 1 0]);
infoMsg = ''; taskMsg = ''; stBlock = '';
showHose = false;
valveU = 0; flowQ = 0; pLine = 0; pTrack = false;     % valve opening 0..1, flow L/s, line pressure bar
pBuf = []; tpBuf = []; pExpBuf = []; tFillStart = NaN; tFillEnd = NaN;
Pnom = 2.5; P0 = 0.3; Ptrip = 4.5;                    % bar: hose loss at rated flow, static, trip limit
kHose = (Pnom - P0)/flowRate^2;                       % hose + nozzle loss coefficient
obstacle = [];                              % [x0 x1 y0 y1 z0 z1] world box
poseRef = [0 0 0]; watchOn = false; driftOn = false;      % vehicle motion monitor
driftSpeed = 0.03; driftLimit = 0.015; yawLimit = deg2rad(1);   % creep speed (m/s), trip limits (m, rad)
cycleNo = 0; cycleTot = 0;
tBuf = []; qaBuf = zeros(0,3); qrBuf = zeros(0,3); trackOn = false;
plan = {};
samples = zeros(40,3); trueInl = [0 0 0];

%% ===================== figure =====================
if ~isempty(P.Figure) && ishghandle(P.Figure)
    fig = P.Figure; clf(fig);
else
    fig = figure('Name','Robotic Fuel Station - Workflow','NumberTitle','off', ...
        'Color','w','Units','pixels','Position',[20 40 1520 900]);
end
if ~isempty(P.Header)
    annotation(fig,'textbox',[0.30 0.972 0.69 0.026],'String',P.Header,'EdgeColor','none','FontWeight','bold', ...
        'FontSize',10.5,'Color',[0.1 0.2 0.5],'Interpreter','none','VerticalAlignment','middle');
end

% ---------- flowchart ----------
cIdle = [0.93 0.93 0.93]; cAct = [1.00 0.85 0.20]; cDone = [0.62 0.90 0.62];
cFault = [1.00 0.45 0.45]; cWarn = [1.00 0.70 0.35];
cEdge = [0.50 0.50 0.50]; cLit = [0.10 0.40 0.90];
axF = axes('Parent',fig,'Position',[0.005 0.02 0.28 0.96]);
hold(axF,'on'); axis(axF,'off'); xlim(axF,[0 11]); ylim(axF,[1.2 22.9]); daspect(axF,[1 1 1]);

nodeDef = { ...
 'arrive','VEHICLE ARRIVES','term',5.5,22.0,3.4,0.62
 'detect','Vehicle detection','proc',5.5,21.0,4.4,0.62
 'position','Vehicle positioning','proc',5.5,20.0,4.4,0.62
 'safe','Is position safe?','dec',5.5,18.7,3.8,1.5
 'reposition','Reposition','proc',1.25,18.7,2.1,0.62
 'inlet','Detect fuel inlet','proc',5.5,17.2,4.4,0.62
 'flap','Check fuel flap','proc',5.5,16.2,4.4,0.62
 'target','Calculate target','proc',5.5,15.2,4.4,0.62
 'ik','Inverse Kinematics','proc',5.5,14.2,4.4,0.62
 'coll','Collision Checking','proc',5.5,13.2,4.4,0.62
 'traj','Trajectory Planning','proc',5.5,12.2,4.4,0.62
 'dyn','Dynamics + Controller','proc',5.5,11.2,4.4,0.62
 'move','Move Robot','proc',5.5,10.2,4.4,0.62
 'align','Alignment','proc',5.5,9.2,4.4,0.62
 'insert','Nozzle Insertion','proc',5.5,8.2,4.4,0.62
 'dispense','Fuel Dispensing','proc',5.5,7.2,4.4,0.62
 'normal','Normal operation','proc',3.0,6.0,3.4,0.62
 'fault','Fault detected','proc',8.1,6.0,3.0,0.62
 'stop','Stop at target','proc',3.0,5.0,3.4,0.62
 'emerg','Emergency stop','proc',8.1,5.0,3.0,0.62
 'remove','Remove nozzle','proc',3.0,4.0,3.4,0.62
 'fueloff','Fuel OFF','proc',8.1,4.0,3.0,0.62
 'home','Return Home','proc',3.0,3.0,3.4,0.62
 'complete','COMPLETE','term',3.0,2.0,3.0,0.62 };

nodes = struct();
for i = 1:size(nodeDef,1)
    k = nodeDef{i,1}; cx = nodeDef{i,4}; cy = nodeDef{i,5}; w = nodeDef{i,6}; h = nodeDef{i,7};
    switch nodeDef{i,3}
        case 'term'
            hb = rectangle('Parent',axF,'Position',[cx-w/2 cy-h/2 w h],'Curvature',[1 1], ...
                'FaceColor',cIdle,'EdgeColor',[0.3 0.3 0.3],'LineWidth',1.2);
        case 'proc'
            hb = rectangle('Parent',axF,'Position',[cx-w/2 cy-h/2 w h], ...
                'FaceColor',cIdle,'EdgeColor',[0.3 0.3 0.3],'LineWidth',1.2);
        otherwise
            hb = patch('Parent',axF,'XData',[cx cx+w/2 cx cx-w/2],'YData',[cy+h/2 cy cy-h/2 cy], ...
                'FaceColor',cIdle,'EdgeColor',[0.3 0.3 0.3],'LineWidth',1.2);
    end
    text(cx,cy,nodeDef{i,2},'Parent',axF,'HorizontalAlignment','center', ...
        'FontSize',8.5,'FontWeight','bold','Interpreter','none');
    nodes.(k) = struct('hnd',hb,'cx',cx,'cy',cy,'w',w,'h',h,'label',nodeDef{i,2});
end

nb = @(k) [nodes.(k).cx, nodes.(k).cy - nodes.(k).h/2];
nt = @(k) [nodes.(k).cx, nodes.(k).cy + nodes.(k).h/2];
nl = @(k) [nodes.(k).cx - nodes.(k).w/2, nodes.(k).cy];
nr = @(k) [nodes.(k).cx + nodes.(k).w/2, nodes.(k).cy];
vert = @(a,b) {a, b, [nb(a); nt(b)]};
yb = 6.6;                                   % y of the branch bar
edgeDef = { ...
 vert('arrive','detect'), vert('detect','position'), vert('position','safe'), ...
 {'safe','inlet',[nb('safe'); nt('inlet')]}, ...
 {'safe','reposition',[nl('safe'); nr('reposition')]}, ...
 {'reposition','position',[nt('reposition'); nodes.reposition.cx nodes.position.cy; nl('position')]}, ...
 vert('inlet','flap'), vert('flap','target'), vert('target','ik'), vert('ik','coll'), ...
 vert('coll','traj'), vert('traj','dyn'), vert('dyn','move'), vert('move','align'), ...
 vert('align','insert'), vert('insert','dispense'), ...
 {'dispense','normal',[nb('dispense'); nodes.dispense.cx yb; nodes.normal.cx yb; nt('normal')]}, ...
 {'dispense','fault', [nb('dispense'); nodes.dispense.cx yb; nodes.fault.cx yb;  nt('fault')]}, ...
 vert('normal','stop'), vert('stop','remove'), vert('remove','home'), vert('home','complete'), ...
 vert('fault','emerg'), vert('emerg','fueloff') };
E = struct('id',{},'ln',{},'hd',{});
for i = 1:numel(edgeDef)
    d = edgeDef{i}; xy = d{3};
    ln = plot(axF,xy(:,1),xy(:,2),'-','Color',cEdge,'LineWidth',1.3);
    hd = arrowHead(axF,xy(end-1,1),xy(end-1,2),xy(end,1),xy(end,2),cEdge);
    E(end+1) = struct('id',[d{1} '>' d{2}],'ln',ln,'hd',hd); %#ok<AGROW>
end
text(3.4,18.95,'NO','Parent',axF,'FontSize',9,'FontWeight','bold','Color',[0.7 0 0]);
text(5.65,17.72,'YES','Parent',axF,'FontSize',9,'FontWeight','bold','Color',[0 0.5 0]);
hCycle = text(7.9,13.7,'','Parent',axF,'FontSize',8.5,'Color',cLit,'FontAngle','italic', ...
    'VerticalAlignment','middle','Interpreter','none');

% ---------- 3D scene ----------
axS = axes('Parent',fig,'Position',[0.30 0.33 0.69 0.65]); hold(axS,'on'); grid(axS,'on');
xl = [min(-0.6, ideal(1)+V.ext(1)-0.4), max(2.6, ideal(1)+V.ext(2)+0.4)];
yl = [-0.8, ideal(2)+V.ext(4)+0.5];
zl = [0, max(2.3, V.ext(6)+0.3)];
xlim(axS,xl); ylim(axS,yl); zlim(axS,zl); daspect(axS,[1 1 1]); view(axS,[-38 24]);
xlabel(axS,'x along bay (m)'); ylabel(axS,'y toward vehicle (m)'); zlabel(axS,'z (m)');
patch('Parent',axS,'XData',xl([1 2 2 1]),'YData',yl([1 1 2 2]),'ZData',[0 0 0 0], ...
    'FaceColor',[0.94 0.94 0.94],'EdgeColor','none');
plot3(axS,[0 2.3],[0 0],[z0 z0],'k-','LineWidth',5);
plot3(axS,[0 0],[0 0],[0 z0],'k-','LineWidth',4);
plot3(axS,[2.3 2.3],[0 0],[0 z0],'k-','LineWidth',4);
