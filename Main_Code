end

function s = addCommas(x)
s = sprintf('%.0f', x); k = numel(s) - 3;
while k > 0, s = [s(1:k) ',' s(k+1:end)]; k = k - 3; end
end

function writeSheet(file, sheet, C)
% C is a cell array; writes it to one worksheet (works with or without Excel installed)
for i = 1:numel(C), if isempty(C{i}), C{i} = ''; end, end
if exist('writecell') > 0 %#ok<EXIST>
    writecell(C, file, 'Sheet', sheet);
else
    xlswrite(file, C, sheet);
end
end

function formatExcel(file)
% Optional cosmetics (Windows + Excel installed): bold coloured header, auto-fit columns, freeze row 1.
if ~ispc, return; end
try
    e = actxserver('Excel.Application'); e.DisplayAlerts = false;
    wb = e.Workbooks.Open(file);
    for s = 1:wb.Sheets.Count
        sh = wb.Sheets.Item(s);
        sh.Cells.EntireColumn.AutoFit;
        h = sh.Rows.Item(1); h.Font.Bold = true; h.Font.Color = 16777215; h.Interior.Color = 9981952;
        sh.Activate; e.ActiveWindow.SplitRow = 1; e.ActiveWindow.FreezePanes = true;
        if s == 1, sh.Columns.Item(1).ColumnWidth = 48; sh.Columns.Item(2).ColumnWidth = 40; end
    end
    wb.Sheets.Item(1).Activate;
    wb.Save; wb.Close; e.Quit; delete(e);
catch
end
end
