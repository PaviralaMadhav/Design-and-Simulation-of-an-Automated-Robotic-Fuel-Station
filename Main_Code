%% ###########################################################################
%%                           NESTED FUNCTIONS
%% ###########################################################################

    function runWorkflow()
        % ---------------- VEHICLE ARRIVES ----------------
        enter('arrive','');
        infoMsg = 'Vehicle entering the fuelling bay';
        waitSim(4.5, @(f) driveIn(f));
        leave('arrive');

        % ---------------- Vehicle detection ----------------
        enter('detect','arrive');
        infoMsg = 'LiDAR + camera sweep: finding the vehicle outline and heading';
        waitSim(3.0, @(f) sweepRays(f));
        showBBox();
        [sR0, sF0] = lidarEnds();
        infoMsg = sprintf('Vehicle outline found: length %.1f m. Type not known yet (read from the inlet position)', sF0 - sR0);
        waitSim(0.8, []);
        setRays(0); leave('detect');

        % ---------------- positioning / safety loop ----------------
        prev = 'detect';
        while true
            enter('position',prev);
            showBay();
            infoMsg = 'Measuring heading and near-side gap (safe zone = green dashes)';
            waitSim(1.5, []);
            Cg = bodyCorners(V,pose);
            gapM = min(Cg(:,2)) + 0.005*randn;
            yawDeg = rad2deg(pose(3) + deg2rad(0.4)*randn);
            infoMsg = sprintf('Near-side gap %.0f mm (safe 200-1100) | heading error %+.1f deg (limit 3)', gapM*1e3, yawDeg);
            waitSim(1.0, []);
            leave('position');
            enter('safe','position');
            waitSim(1.0, []);
            if abs(yawDeg) <= 3 && gapM >= 0.20 && gapM <= 1.10
                infoMsg = 'Position SAFE (heading within 3 deg, gap inside the safe zone)';
                leave('safe');
                break;
            end
            setNode('safe','warn');
            infoMsg = 'Position NOT safe -> driver guidance / reposition'; nRepark = nRepark + 1;
            enter('reposition','safe');
            from = pose; to = repark;
            advice = {};
            if abs(yawDeg) > 3, advice{end+1} = sprintf('straighten %.1f deg', abs(yawDeg)); end %#ok<AGROW>
            if gapM > 1.10, advice{end+1} = 'move closer to the pump'; elseif gapM < 0.20, advice{end+1} = 'move away from the pump'; end %#ok<AGROW>
            banner(['PLEASE ' strjoin(advice,' and ')], [0.85 0.4 0]);
            waitSim(4.5, @(f) moveVeh(from,to,f));
            banner('');
            leave('reposition');
            setNode('position','idle'); setNode('safe','idle');
            prev = 'reposition';
        end

        % ---------------- Detect fuel inlet ----------------
        enter('inlet','safe');
        trueInl = [pose(1) pose(2) ideal(3)];
        if P.Calibrated
            biasUsed = 0.0002*randn(1,3);          % residual camera bias after the fiducial calibration check
            infoMsg = 'Camera calibration check on the carriage fiducial: bias removed';
        else
            biasUsed = calibBias;                  % camera calibration error NOT removed
            infoMsg = 'WARNING: camera not calibrated - its bias remains';
        end
        waitSim(1.2, []);
        sigma1 = P.CameraNoise/1000;               % per-axis noise of one camera frame (m)
        roundEnds = [60 120 240]; samples = zeros(240,3); nF = 0; detErr = NaN; accepted = false;
        for rd = 1:3
            while nF < roundEnds(rd)
                nF = nF + 1;
                samples(nF,:) = trueInl + biasUsed + sigma1*randn(1,3);
                est.inlet = mean(samples(1:nF,:),1);
                detErr = norm(est.inlet - trueInl);
                set(hEst,'XData',est.inlet(1),'YData',est.inlet(2),'ZData',est.inlet(3));
                infoMsg = sprintf('Round %d, frame %d: detected error = %.2f mm  (must be < %.1f mm)', ...
                    rd, nF, detErr*1e3, P.MaxDetectError);
                tick();
            end
            if detErr*1e3 < P.MaxDetectError, accepted = true; break; end
            infoMsg = sprintf('Error %.2f mm is not below %.1f mm -> averaging more frames', detErr*1e3, P.MaxDetectError);
            waitSim(0.6, []);
        end
        detErrShow = detErr*1e3;
        if ~accepted
            banner(sprintf('INLET DETECTION ERROR %.2f mm (limit %.1f mm): INLET NOT OPENED', detErrShow, P.MaxDetectError), [0.8 0 0]);
            fprintf('Inlet detection: error %.2f mm is NOT below %.1f mm after %d frames -> REJECTED, inlet not opened.\n', ...
                detErrShow, P.MaxDetectError, nF);
            error('WF:fault','%s',sprintf('Inlet detection error %.2f mm is not below %.1f mm: inlet NOT opened', ...
                detErrShow, P.MaxDetectError));
        end
        fprintf('Inlet detection: error %.2f mm (limit %.1f mm), %d frames -> ACCEPTED, the inlet may be opened.\n', ...
            detErrShow, P.MaxDetectError, nF);
        banner(sprintf('INLET DETECTION ERROR %.2f mm (< %.1f mm): OK, inlet may be opened', detErrShow, P.MaxDetectError), [0 0.5 0]);
        infoMsg = sprintf('Inlet located: detected error %.2f mm < %.1f mm after %d frames', detErrShow, P.MaxDetectError, nF);
        waitSim(1.6, []);
        banner('');

        % --- vehicle type from where the inlet sits along the body (rear / middle / front)
        [sRearM, sFrontM, hdg, yawEst] = lidarEnds();
        sInlet = est.inlet(1:2)*hdg';
        detFrac = (sInlet - sRearM)/(sFrontM - sRearM);
        [detCls, detZone] = classifyVehicle(detFrac);
        detList = {'car','lorry','bike'};
        detName = detList{detCls};
        Vd = vehicleDef(detName,1); Vd.fuel = NaN;
        detTitle = Vd.title;
        targetLitres = min(P.Litres, Vd.tank); flowRate = Vd.flow; kHose = (Pnom - P0)/flowRate^2;
        drawRuler(sRearM, sFrontM, sInlet, hdg, est.inlet);
        infoMsg = sprintf('Inlet is at %.0f%% of the body length from the rear (%s) -> %s', 100*detFrac, detZone, detTitle);
        banner(['VEHICLE DETECTED: ' detTitle '  (inlet at the ' upper(detZone) ')'], [0 0.35 0.8]);
        fprintf('Vehicle type: inlet at %.0f%% of the body from the rear (%s) -> %s.\n', 100*detFrac, detZone, detTitle);
        waitSim(2.5, []);
        banner(''); clearRuler();
        if strcmp(Vd.dirType,'top'), est.dir = [0 0 -1]; else, est.dir = [-sin(yawEst) cos(yawEst) 0]; end
        poseRef = pose; watchOn = true; showRefBox();      % arm the vehicle motion monitor

        % --- fuel label (OCR) must match what the customer asked for
        labelFuel = V.fuel;
        infoMsg = sprintf('Fuel label read: %s | customer asked: %s', fuelNames{labelFuel}, fuelNames{fuelReq});
        waitSim(1.2, []);
        if labelFuel ~= fuelReq
            error('WF:fault','%s',sprintf('WRONG FUEL: vehicle needs %s, customer chose %s', ...
                fuelNames{labelFuel}, fuelNames{fuelReq}));
        end
        leave('inlet');

        % ---------------- Check fuel flap ----------------
        enter('flap','inlet');
        switch Vd.flap
            case 'push',   infoMsg = 'Flap: CLOSED, push-to-open type -> robot must press it';
            case 'remote', infoMsg = 'Flap: LOCKED, remote-unlock type -> send unlock signal';
            otherwise,     infoMsg = 'No flap: cap is directly accessible';
        end
        waitSim(1.8, []);
        leave('flap');

        % ---------------- Calculate target ----------------
        enter('target','flap');
        infoMsg = 'Computing waypoints and tool sequence from the inlet estimate';
        buildPlan();
        cycleTot = sum(cellfun(@(s) strcmp(s.kind,'move'), plan));
        waitSim(2.0, []);
        leave('target');

        % ---------------- IK -> Collision -> Trajectory -> Dynamics -> Move (per waypoint) ----------------
        prevNode = 'target';
        for pIdx = 1:numel(plan)
            s = plan{pIdx};
            if strcmp(s.kind,'act')
                performAction(s);
            else
                pipelineMove(s, prevNode);
                prevNode = 'move';
            end
        end
        clearPlanGraphics();

        % ---------------- Alignment ----------------
        enter('align','move');
        dT = inletDir(V,pose); inlT = [pose(1) pose(2) ideal(3)];
        ndirGoal = dT;
        setRet(inlT, dT, true);
        for it = 1:6
            tp = fk3(q); e = inlT - tp; eLat = e - dot(e,dT)*dT; aErr = norm(eLat);
            infoMsg = sprintf('Wrist camera: lateral error %.1f mm (iteration %d)', aErr*1e3, it);
            taskMsg = 'Visual servoing onto the inlet axis';
            if aErr < 0.002, break; end
            runLeg(tp, tp + 0.8*eLat, 0.2);
        end
        waitSim(0.6, []);
        setRet(inlT, dT, false);
        infoMsg = sprintf('Aligned to %.1f mm - nozzle axis matches inlet axis', aErr*1e3);
        leave('align');

        % ---------------- Nozzle Insertion ----------------
        enter('insert','align');
        taskMsg = 'Inserting nozzle with compliance';
        infoMsg = 'Pushing nozzle into the filler neck (8 cm)';
        runLeg(fk3(q), inlT + 0.08*dT, 0.12);
        e = inlT - fk3(q); eLat = e - dot(e,dT)*dT;
        if norm(eLat) > 0.012
            error('WF:fault','%s','Nozzle jammed: misaligned with the filler neck');
        end
        seated = true; valveOpen = true;
        infoMsg = 'Nozzle seated - interlock closed, valve armed';
        waitSim(0.8, []);
        leave('insert');

        % ---------------- Fuel Dispensing ----------------
        enter('dispense','insert');
        taskMsg = sprintf('Dispensing %s: target %.1f L, rated %.1f L/s', fuelNames{fuelReq}, targetLitres, flowRate);
        flowing = true; pTrack = true; pBuf = []; tpBuf = []; pExpBuf = [];
        valveU = 0; flowQ = 0; qInt = 0; tD = 0; faultT0 = NaN; tFillStart = simT;
        % pressure/flow schedule depends on the fraction of the requested quantity already pumped
        tankFullCase = P.Litres >= Vd.tank;
        while targetLitres - litres > 0.01
            tD = tD + dt;
            % flow set-point: quick start (0.8 s), full flow, then taper over the last 15 % of the quantity
            frac = litres/targetLitres;
            tpr = min(1, max(0, (frac - 0.85)/0.14)); taperS = tpr*tpr*(3 - 2*tpr);
            Qt = flowRate*min(1, tD/0.8)*(1 - 0.85*taperS);
            % PI flow controller with feed-forward, valve actuator lag 0.5 s
            eQ = (Qt - flowQ)/flowRate;
            qInt = max(-1, min(1, qInt + eQ*dt));
            uCmd = min(1, max(0, Qt/flowRate + 0.8*eQ + 1.5*qInt));
            valveU = valveU + (uCmd - valveU)*dt/0.5;
            flowQ = valveU*flowRate;
            litres = min(targetLitres, litres + flowQ*dt);
            if strcmp(moveMode,'fuelling') && litres >= 0.3*targetLitres, driftOn = true; end
            % line pressure: P = P0 + b*k*Q^2  (b = blockage factor; a leak lowers the reading)
            blk = 1; lk = 0;
            if litres >= 0.4*targetLitres && ~strcmp(faultMode,'none')
                if isnan(faultT0), faultT0 = tD; end
                ramp = min(1, (tD - faultT0)/1.5);
                if strcmp(faultMode,'overpressure'), blk = 1 + 2.5*ramp; end
                if strcmp(faultMode,'leak'), lk = ramp; end
            end
            surge = 0.6*(1 - exp(-tD/0.15))*exp(-tD/1.5);   % start-up pressure surge (peaks at the start)
            head  = 0.8*(1 - frac);                          % pump head: pressure falls as the quantity pumped grows
            pExp  = P0 + kHose*flowQ^2 + surge + head;
            pLine = P0 + blk*kHose*flowQ^2*(1 - 0.6*lk) + surge + head + 0.02*randn;
            peakP = max(peakP, pLine);
            if frac < 0.85, phaseTxt = 'peak then gradual decline'; else, phaseTxt = 'tapering: pressure falling'; end
            tpBuf(end+1) = simT; pBuf(end+1) = pLine; pExpBuf(end+1) = pExp; %#ok<AGROW>
            if numel(tpBuf) > 400, tpBuf = tpBuf(end-399:end); pBuf = pBuf(end-399:end); pExpBuf = pExpBuf(end-399:end); end
            infoMsg = sprintf('Pumping %s: %.1f / %.1f L | %.2f L/s | %.2f bar | %s', fuelNames{fuelReq}, litres, targetLitres, flowQ, pLine, phaseTxt);
            % protection logic
            if pLine > Ptrip
                tick();
                error('WF:fault','%s',sprintf('OVER-PRESSURE %.1f bar (limit %.1f): nozzle or hose blocked', pLine, Ptrip));
            end
            if flowQ > 0.3*flowRate && pLine < 0.7*pExp
                tick();
                error('WF:fault','%s','LEAK: line pressure fell below the expected value for this flow');
            end
            tick();
        end
        litres = targetLitres;
        if tankFullCase
            infoMsg = 'Tank full: back-pressure spike -> nozzle auto shut-off';
            for kq = 1:20
                flowQ = flowQ*0.6; valveU = flowQ/flowRate;
                pLine = P0 + 2.8*exp(-(kq-6)^2/12) + 0.02*randn; pExp = P0;
                tpBuf(end+1) = simT; pBuf(end+1) = pLine; pExpBuf(end+1) = pExp; %#ok<AGROW>
                tick();
            end
        end
        flowing = false; flowQ = 0; pTrack = false; tFillEnd = simT;
        leave('dispense');

        % ---------------- Normal operation ----------------
        enter('normal','dispense');
        infoMsg = 'Target reached - no faults detected';
        waitSim(0.8, []);
        leave('normal');

        enter('stop','normal');
        valveOpen = false; valve0 = valveU;
        infoMsg = sprintf('Valve closing smoothly - flow stopped at %.1f L', litres);
        waitSim(1.2, @(f) setValve(valve0*(1-f)));
        pLine = 0;
        leave('stop');

        enter('remove','stop');
        postSequence();
        leave('remove');

        enter('home','remove');
        taskMsg = 'Arm returning to its home position'; infoMsg = 'Moving home';
        ndirGoal = [0 1 0]; tool = 0;
        runLeg(fk3(q), homePos, 0.5);
        leave('home');

        enter('complete','home');
        infoMsg = sprintf('Fuelling complete: %.1f L of %s dispensed. Vehicle may leave.', litres, fuelNames{fuelReq});
        banner('COMPLETE', [0 0.55 0]);
        waitSim(1.0, []);
        watchOn = false; driftOn = false; set(hRefBox,'XData',NaN,'YData',NaN,'ZData',NaN);
        from = pose; to = [pose(1)+9, pose(2), 0];
        waitSim(5.0, @(f) moveVeh(from,to,f));
        leave('complete');
    end

    % ------------------------------------------------------------------
    function faultPath(msg)
        if ~isnan(tFillStart) && isnan(tFillEnd), tFillEnd = simT; end
        driftOn = false; inFault = true; flowing = false; valveOpen = false; flowQ = 0; valveU = 0; pLine = 0; pTrack = false;
        if ~isempty(curNode), setNode(curNode,'fault'); end
        if strcmp(curNode,'dispense'), litEdge('dispense','fault'); end
        setNode('fault','fault');
        infoMsg = ['FAULT: ' msg]; taskMsg = 'Fault detected';
        banner('FAULT DETECTED', [0.8 0 0]);
        waitSim(1.5, []);
        litEdge('fault','emerg'); setNode('emerg','fault'); stBlock = 'Emergency stop';
        infoMsg = 'EMERGENCY STOP: all motion frozen, pump stopped';
        banner('EMERGENCY STOP', [0.8 0 0]);
        waitSim(2.5, @(f) blink(f));
        litEdge('emerg','fueloff'); setNode('fueloff','fault'); stBlock = 'Fuel OFF';
        infoMsg = 'FUEL OFF: pump stopped, valve closed. Attendant required.';
        waitSim(2.0, []);
    end

    % ------------------------------------------------------------------
    function pipelineMove(s, prevNode)
        cycleNo = cycleNo + 1;
        for kk = {'ik','coll','traj','dyn','move'}, setNode(kk{1},'idle'); end
        set(hCycle,'String',sprintf('waypoint %d / %d\n%s', cycleNo, cycleTot, s.label));
        taskMsg = sprintf('Waypoint %d/%d: %s', cycleNo, cycleTot, s.label);
        p1 = s.pos; p0 = fk3(q);
        tool = s.tool;
        if tool >= 1, ndirGoal = est.dir; end

        % --- Inverse Kinematics
        enter('ik',prevNode);
        [qg,ok] = ik3(p1);
        if ~ok, error('WF:fault','%s','IK: target out of reach of the arm'); end
        infoMsg = sprintf('IK: rail x=%.2f m, shoulder=%.0f deg, elbow=%.0f deg', qg(1), rad2deg(qg(2)), rad2deg(qg(3)));
        waitSim(0.6, @(f) ghostArm(qg,f));
        leave('ik');

        % --- Collision Checking (with replanning)
        enter('coll','ik');
        pts = [p0; p1];
        [hit, S] = pathCollides(pts);
        waitSim(0.7, @(f) showSamples(S,f));
        if hit
            infoMsg = 'COLLISION predicted on the straight path -> replanning with a via-point';
            nReplan = nReplan + 1; setNode('coll','warn'); waitSim(0.8, []);
            found = false;
            mid = (p0+p1)/2;
            cand = [0 0 0.25; 0 -0.2 0.25; 0 -0.25 -0.2];
            for c = 1:size(cand,1)
                via = mid + cand(c,:);
                [h1,S1] = pathCollides([p0; via; p1]);
                if ~h1
                    pts = [p0; via; p1]; S = S1; found = true; break;
                end
            end
            if ~found, error('WF:fault','%s','No collision-free path found'); end
            waitSim(0.7, @(f) showSamples(S,f));
            infoMsg = 'Collision-free path found';
        else
            infoMsg = 'Path is collision-free (all swept samples clear of vehicle and obstacles)';
        end
        leave('coll');

        % --- Trajectory Planning
        enter('traj','coll');
        set(hPath,'XData',pts(:,1),'YData',pts(:,2),'ZData',pts(:,3));
        len = sum(sqrt(sum(diff(pts,1,1).^2,2)));
        infoMsg = sprintf('Minimum-jerk trajectory: %.2f m path, peak speed 0.35 m/s', len);
        waitSim(0.7, []);
        leave('traj');

        % --- Dynamics + Controller
        enter('dyn','traj');
        infoMsg = sprintf('Joint PD controller: Kp=%d, Kd=%d  (wn = 10 rad/s, zeta = 0.75)', Kp, Kd);
        trackOn = true; tBuf = []; qaBuf = zeros(0,3); qrBuf = zeros(0,3);
        waitSim(0.5, []);
        leave('dyn');

        % --- Move Robot
        enter('move','dyn');
        if strcmp(moveMode,'approach') && cycleNo == 1, driftOn = true; end
        infoMsg = 'Arm following the planned trajectory';
        for j = 1:size(pts,1)-1
            runLeg(pts(j,:), pts(j+1,:), 0.35);
        end
        leave('move');
        set(hGhost,'XData',NaN,'YData',NaN,'ZData',NaN);
        set(hCok,'XData',NaN,'YData',NaN,'ZData',NaN);
        set(hCbad,'XData',NaN,'YData',NaN,'ZData',NaN);
        set(hPath,'XData',NaN,'YData',NaN,'ZData',NaN);
    end

    % ------------------------------------------------------------------
    function runLeg(p0, p1, vmax)
        dist = norm(p1 - p0);
        T = max(0.6, 1.875*dist/vmax);
        n = ceil(T/dt);
        for k = 1:n
            tau = k/n; sj = 10*tau^3 - 15*tau^4 + 6*tau^5;
            stepDyn(p0 + sj*(p1-p0));
            tick();
        end
        for k = 1:60
            stepDyn(p1);
            if norm(fk3(q) - p1) < 0.001 && norm(qd) < 0.02, break; end
            tick();
        end
    end

    function stepDyn(pref)
        [qr,ok] = ik3(pref);
        if ~ok, error('WF:fault','%s','Target out of reach of the arm'); end
        for sub = 1:2
            acc = Kp*(qr - q) - Kd*qd;
            qd = qd + acc*(dt/2);
            q  = q + qd*(dt/2);
        end
        lastAcc = acc;
        qRef = qr;
        ndir = ndir + 0.15*(ndirGoal - ndir);
        ndir = ndir/norm(ndir);
        if trackOn
            tBuf(end+1,1) = simT; qaBuf(end+1,:) = q; qrBuf(end+1,:) = qRef; %#ok<AGROW>
            if numel(tBuf) > 300
                tBuf = tBuf(end-299:end); qaBuf = qaBuf(end-299:end,:); qrBuf = qrBuf(end-299:end,:);
            end
        end
    end

    function quick(p)
        runLeg(fk3(q), p, 0.5);
    end

    % ------------------------------------------------------------------
    function buildPlan()
        d = est.dir; inl = est.inlet; st = inl - 0.15*d; tray = [inl(1) 0.35 0.9];
        pl = {}; lastPos = [];
        switch Vd.flap
            case 'push'
                pl{end+1} = mv('Approach flap', st, 0);
                pl{end+1} = mv('Press flap', inl + 0.01*d, 1);
                pl{end+1} = ac('Flap springs open', 'flapOpen');
                pl{end+1} = mv('Retreat from flap', st, 0); lastPos = st;
            case 'remote'
                pl{end+1} = ac('Remote unlock sent', 'remoteUnlock');
        end
        if isempty(lastPos), pl{end+1} = mv('Approach cap', st, 2); end
        pl{end+1} = mv('Grip cap', inl + 0.02*d, 2);
        pl{end+1} = ac('Unscrew cap (2 turns)', 'unscrew');
        pl{end+1} = mv('Stow cap in tray', tray, 2);
        pl{end+1} = ac('Release cap in tray', 'release');
        pl{end+1} = mv('Approach with nozzle', st, 3);
        plan = pl;
        % optional obstacle on the first leg
        if P.Obstacle
            first = plan{find(cellfun(@(s) strcmp(s.kind,'move'), plan),1)};
            m = (homePos + first.pos)/2;
            obstacle = [m(1)-0.07 m(1)+0.07 m(2)-0.07 m(2)+0.07 m(3)-0.07 m(3)+0.07];
            set(hObs,'Vertices',boxWorld(obstacle,[0 0 0]),'Visible','on');
        end
        % show numbered waypoints
        mvIdx = find(cellfun(@(s) strcmp(s.kind,'move'), plan));
        mp = zeros(numel(mvIdx),3);
        for jj = 1:numel(mvIdx), mp(jj,:) = plan{mvIdx(jj)}.pos; end
        set(hWP,'XData',mp(:,1),'YData',mp(:,2),'ZData',mp(:,3));
        for jj = 1:size(mp,1)
            hWPtxt(end+1) = text(mp(jj,1),mp(jj,2),mp(jj,3)+0.07,num2str(jj),'Parent',axS, ...
                'FontSize',9,'Color',[0.6 0 0.6],'FontWeight','bold'); %#ok<AGROW>
        end
    end

    function performAction(s)
        taskMsg = s.label;
        switch s.act
            case 'flapOpen'
                infoMsg = 'Flap released by the spring latch';
                waitSim(1.2, @(f) setFlap(1.75*f));
            case 'remoteUnlock'
                infoMsg = 'Wireless unlock command -> vehicle opens the flap';
                waitSim(0.8, []);
                waitSim(1.2, @(f) setFlap(1.75*f));
            case 'unscrew'
                capState = 2;
                infoMsg = 'Gripper turns the cap anticlockwise 2 turns';
                waitSim(3.0, @(f) setWrist(4*pi*f));
            case 'release'
                capState = 3; tool = 0;
                infoMsg = 'Cap parked in the carriage tray';
                waitSim(0.8, []);
        end
    end

    function postSequence()
        dd = inletDir(V,pose); inl = [pose(1) pose(2) ideal(3)];
        st = inl - 0.15*dd; tray = [inl(1) 0.35 0.9];
        ndirGoal = dd; tool = 3;
        taskMsg = 'Withdrawing the nozzle'; infoMsg = 'Nozzle leaving the filler neck';
        showHose = true; seated = false;
        quick(st);
        taskMsg = 'Holstering the nozzle'; infoMsg = 'Nozzle returned to its holder';
        quick(tray); tool = 0; waitSim(0.6, []);
        taskMsg = 'Refitting the cap'; infoMsg = 'Picking the cap from the tray';
        tool = 2; capState = 2; waitSim(0.6, []);
        quick(st); quick(inl + 0.02*dd);
        infoMsg = 'Screwing the cap back on (2 turns)';
        waitSim(3.0, @(f) setWrist(4*pi*(1-f)));
        capState = 1; wrist = 0; tool = 0; waitSim(0.5, []);
        quick(st);
        switch Vd.flap
            case 'push'
                taskMsg = 'Closing the flap'; tool = 1; infoMsg = 'Pressing the flap shut';
                quick(inl + 0.01*dd);
                waitSim(1.0, @(f) setFlap(1.75*(1-f)));
                tool = 0; quick(st);
            case 'remote'
                taskMsg = 'Closing the flap'; infoMsg = 'Wireless lock command -> flap closes';
                waitSim(1.2, @(f) setFlap(1.75*(1-f)));
        end
        showHose = false;
    end

    % ------------------------------------------------------------------
    function [hit, S] = pathCollides(pts)
        hit = false; S = zeros(0,4);   % [x y z flag]
        for j = 1:size(pts,1)-1
            for a = linspace(0,1,12)
                p = pts(j,:) + a*(pts(j+1,:)-pts(j,:));
                [qq,ok] = ik3(p);
                if ok, bad = linkInCollision(qq); else, bad = true; end
                if bad, hit = true; end
                S(end+1,:) = [p, double(bad)]; %#ok<AGROW>
            end
        end
    end

    function bad = linkInCollision(qq)
        base = [qq(1) 0 z0]; el = [qq(1) L1*cos(qq(2)) z0+L1*sin(qq(2))]; tp = fk3(qq);
        bad = false;
        for a = linspace(0,1,7)
            for pnt = {base + a*(el-base), el + a*(tp-el)}
                pp = pnt{1};
                if norm(pp - est.inlet) < 0.25, continue; end      % docking zone
                if pointHitsVehicle(pp) || pointInBox(pp,obstacle,0.03)
                    bad = true; return;
                end
            end
        end
    end

    function hit = pointHitsVehicle(pp)
        c = cos(pose(3)); s = sin(pose(3));
        lx =  (pp(1)-pose(1))*c + (pp(2)-pose(2))*s;
        ly = -(pp(1)-pose(1))*s + (pp(2)-pose(2))*c;
        hit = false;
        for b = 1:nBox
            bx = V.boxes(b,1:6); m = 0.03;
            if lx>=bx(1)-m && lx<=bx(2)+m && ly>=bx(3)-m && ly<=bx(4)+m && pp(3)>=bx(5)-m && pp(3)<=bx(6)+m
                hit = true; return;
            end
        end
    end

