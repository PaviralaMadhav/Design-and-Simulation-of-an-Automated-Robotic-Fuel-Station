    % ------------------------------------------------------------------
    function waitSim(dur, fcn)
        nw = max(1, round(dur/dt));
        for iw = 1:nw
            if ~isempty(fcn), fcn(iw/nw); end
            tick();
        end
    end

    function tick()
        simT = simT + dt;
        if driftOn, pose(1) = pose(1) + driftSpeed*dt; end     % vehicle creeping forward
        motionLog(end+1,:) = [simT, q, qd, lastAcc, fk3(q), pose(1)]; %#ok<AGROW>   % motion record for the graphs
        refresh();
        el = toc(tClock);
        w = dt/P.Speed - el;
        if w > 0.001, pause(w); end
        tClock = tic;
    end

    function refresh()
        if ~ishghandle(fig), error('WF:closed','closed'); end
        if estopReq && ~inFault, error('WF:fault','%s','EMERGENCY STOP button pressed'); end
        % vehicle motion monitor
        if watchOn
            dPosM = norm(pose(1:2) - poseRef(1:2)); dYawM = abs(pose(3) - poseRef(3));
            tripped = dPosM > driftLimit || dYawM > yawLimit;
            if tripped && ~inFault
                set(tMon,'String','Vehicle motion monitor: TRIPPED','Color',[0.8 0 0]);
                error('WF:fault','%s',sprintf('VEHICLE MOVED %.0f mm (limit %.0f mm): motion monitor tripped', dPosM*1e3, driftLimit*1e3));
            end
            if tripped, monCol = [0.8 0 0]; monState = 'TRIPPED';
            elseif dPosM > 0.5*driftLimit, monCol = [0.9 0.5 0]; monState = 'VEHICLE MOVING';
            else, monCol = [0 0.5 0]; monState = 'OK'; end
            set(tMon,'String',sprintf('Vehicle motion monitor: %s  (%.0f mm, %.1f deg from reference)', ...
                monState, dPosM*1e3, rad2deg(dYawM)),'Color',monCol);
        else
            set(tMon,'String','Vehicle motion monitor: armed once the inlet is located','Color',[0.4 0.4 0.4]);
        end
        frameCount = frameCount + 1;
        if mod(frameCount, P.FrameSkip) ~= 0, return; end      % draw only every FrameSkip-th step
        % arm
        base = [q(1) 0 z0]; el = [q(1) L1*cos(q(2)) z0+L1*sin(q(2))]; tp = fk3(q);
        set(hArm,'XData',[base(1) el(1) tp(1)],'YData',[base(2) el(2) tp(2)],'ZData',[base(3) el(3) tp(3)]);
        set(hJnt,'XData',[base(1) el(1)],'YData',[base(2) el(2)],'ZData',[base(3) el(3)]);
        set(hTip,'XData',tp(1),'YData',tp(2),'ZData',tp(3),'MarkerFaceColor',toolCol(tool+1,:));
        set(hCarr,'Vertices',boxWorld([-0.12 0.12 -0.1 0.1 -0.12 0.12],[q(1) 0 0]) + repmat([0 0 z0],8,1));
        set(hTray,'Vertices',boxWorld([-0.08 0.08 -0.08 0.08 0 0.03],[q(1) 0.35 0]) + repmat([0 0 0.87],8,1));
        % nozzle + hose
        if tool == 3
            nd = ndir/norm(ndir);
            a = tp - 0.22*nd;
            set(hNoz,'XData',[a(1) tp(1)],'YData',[a(2) tp(2)],'ZData',[a(3) tp(3)]);
        else
            set(hNoz,'XData',NaN,'YData',NaN,'ZData',NaN);
        end
        if tool == 3 || showHose
            if tool == 3, pc = [q(1) 0.0 0.72]; pm = (pc+tp)/2 + [0 0 -0.35];
                tt = linspace(0,1,16)'; H = (1-tt).^2*pc + 2*(1-tt).*tt*pm + tt.^2*tp;
                set(hHose,'XData',H(:,1),'YData',H(:,2),'ZData',H(:,3));
            else
                set(hHose,'XData',NaN,'YData',NaN,'ZData',NaN);
            end
        else
            set(hHose,'XData',NaN,'YData',NaN,'ZData',NaN);
        end
        if flowQ > 0.01*flowRate && seated
            dd = inletDir(V,pose);
            set(hFlow,'LineWidth',1+7*flowQ/flowRate,'XData',[tp(1) tp(1)+0.08*dd(1)],'YData',[tp(2) tp(2)+0.08*dd(2)],'ZData',[tp(3) tp(3)+0.08*dd(3)]);
        else
            set(hFlow,'XData',NaN,'YData',NaN,'ZData',NaN);
        end
        % vehicle
        for b = 1:nBox, set(hBox(b),'Vertices',boxWorld(V.boxes(b,1:6),pose)); end
        inlW = [pose(1) pose(2) ideal(3)]; dW = inletDir(V,pose);
        if ~strcmp(V.flap,'none')
            fv = flapVerts(pose, ideal(3), flapAng);
            set(hFlap,'Vertices',fv,'Visible','on','FaceColor',[0.1 0.2 0.5]*(flapAng<0.3) + [0.9 0.5 0.1]*(flapAng>=0.3));
        end
        accessible = strcmp(V.flap,'none') || flapAng > 0.5;
        if accessible && capState ~= 1
            set(hNeck,'XData',inlW(1),'YData',inlW(2),'ZData',inlW(3));
        else
            set(hNeck,'XData',NaN,'YData',NaN,'ZData',NaN);
        end
        switch capState
            case 1, cp = inlW + 0.015*dW;
            case 2, cp = tp;
            otherwise, cp = [q(1) 0.35 0.90];
        end
        if capState == 3, cp = cp + [0 0 0.03]; end
        set(hCap,'XData',cp(1),'YData',cp(2),'ZData',cp(3));
        a = [0 0 1]; if abs(dot(a,dW)) > 0.9, a = [1 0 0]; end
        u = cross(dW,a); u = u/norm(u); v = cross(dW,u);
        te = cp + 0.03*(cos(wrist)*u + sin(wrist)*v);
        set(hTick,'XData',[cp(1) te(1)],'YData',[cp(2) te(2)],'ZData',[cp(3) te(3)]);
        % litres label
        if litres > 0
            set(hLit,'Position',[pose(1), pose(2), V.ext(6)+0.25],'String',sprintf('%.1f L',litres));
        end
        % tracking plot
        if trackOn && ~isempty(tBuf)
            for i = 1:3
                set(hQa(i),'XData',tBuf,'YData',qaBuf(:,i));
                set(hQr(i),'XData',tBuf,'YData',qrBuf(:,i));
            end
            xlim(axT,[max(0,tBuf(end)-12), max(12,tBuf(end))]);
        end
        % pressure plot
        if pTrack && ~isempty(tpBuf)
            set(hPp,'XData',tpBuf,'YData',pBuf);
            set(hPe,'XData',tpBuf,'YData',pExpBuf);
            xl2 = [max(0,tpBuf(end)-12), max(12,tpBuf(end))];
            xlim(axP,xl2); set(hPl,'XData',xl2,'YData',[Ptrip Ptrip]);
        end
        % status panel
        set(tBlock,'String',stBlock);
        set(tTask,'String',taskMsg);
        set(tInfo,'String',infoMsg);
        if isnan(detErrShow), errTxt = 'detect error: --'; else, errTxt = sprintf('detect error: %.2f mm', detErrShow); end
        set(tVeh,'String',sprintf('%s | asked: %s | %s | t = %.1f s | tool: %s', ...
            detTitle, fuelNames{fuelReq}, errTxt, simT, toolNames{tool+1}));
        if isnan(tFillStart)
            set(tLit,'String',sprintf('%.1f / %.1f L',litres,targetLitres));
        else
            if isnan(tFillEnd), elapsedT = simT - tFillStart; else, elapsedT = tFillEnd - tFillStart; end
            set(tLit,'String',sprintf('%.1f/%.1f L  %.0f s',litres,targetLitres,elapsedT));
        end
        set(hGauge,'Position',[0.02 0.07 max(0.0001, 0.62*litres/targetLitres) 0.12]);
        if valveU > 0.02
            set(tValve,'String',sprintf('Valve %3.0f%% | flow %.2f L/s | line %.2f bar (trip %.1f)', ...
                100*valveU, flowQ, pLine, Ptrip),'Color',[0 0.5 0]);
        else
            set(tValve,'String',sprintf('Valve CLOSED | line pressure %.2f bar', pLine),'Color',[0.7 0 0]);
        end
        drawnow;
    end

end

