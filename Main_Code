    function [sRearM, sFrontM, hdg, yawM] = lidarEnds()
        % LiDAR: vehicle ends along its measured heading (front = direction of travel)
        yawM = pose(3) + deg2rad(0.4)*randn;
        hdg = [cos(yawM) sin(yawM)];
        Cl = bodyCorners(V,pose);
        spl = Cl*hdg';
        sRearM = min(spl) + 0.02*randn;
        sFrontM = max(spl) + 0.02*randn;
    end

    function drawRuler(sRearM, sFrontM, sInlet, hdg, inl)
        nrm = [-hdg(2) hdg(1)];
        edges = [0 0.35 0.65 1.0]; zc = [0.95 0.55 0.10; 0.20 0.70 0.30; 0.10 0.40 0.90];
        zn = {'REAR = car','MIDDLE = lorry','FRONT = bike'};
        for zi = 1:3
            sa = sRearM + edges(zi)*(sFrontM - sRearM); sb = sRearM + edges(zi+1)*(sFrontM - sRearM);
            pa = inl(1:2) + (sa - sInlet)*hdg - 0.35*nrm;
            pb = inl(1:2) + (sb - sInlet)*hdg - 0.35*nrm;
            set(hRule(zi),'XData',[pa(1) pb(1)],'YData',[pa(2) pb(2)],'ZData',[0.05 0.05],'Color',zc(zi,:));
            pm = (pa + pb)/2;
            set(hRuleTxt(zi),'Position',[pm(1) pm(2) 0.18],'String',zn{zi},'Color',zc(zi,:)*0.8);
        end
        pk = inl(1:2) - 0.35*nrm;
        set(hRuleMk,'XData',pk(1),'YData',pk(2),'ZData',0.16);
    end

    function clearRuler()
        for zi = 1:3
            set(hRule(zi),'XData',NaN,'YData',NaN,'ZData',NaN);
            set(hRuleTxt(zi),'String','');
