    function setRays(f)
        n = numel(hRays);
        if f <= 0
            for i = 1:n, set(hRays(i),'XData',NaN,'YData',NaN,'ZData',NaN); end
            return;
        end
        sensor = [1.0, -0.6, 2.3];
        k = max(1, round(f*n));
        xs = linspace(V.ext(1), V.ext(2), n);
        for i = 1:n
            if i <= k
                [wx,wy] = l2w(pose, xs(i), V.ext(3));
                set(hRays(i),'XData',[sensor(1) wx],'YData',[sensor(2) wy],'ZData',[sensor(3) 0.6]);
