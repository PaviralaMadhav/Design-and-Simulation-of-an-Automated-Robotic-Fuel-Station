function [q,ok] = ik3(p)
L1 = 0.65; L2 = 0.65; z0 = 0.6;
py = p(2); dz = p(3) - z0;
D = (py^2 + dz^2 - L1^2 - L2^2) / (2*L1*L2);
ok = abs(D) <= 1 && py >= 0 && p(1) >= 0 && p(1) <= 2.3;
D = max(-1, min(1, D));
q3 = -acos(D);
q2 = atan2(dz,py) - atan2(L2*sin(q3), L1 + L2*cos(q3));
q = [p(1) q2 q3];
end

function tip = fk3(q)
L1 = 0.65; L2 = 0.65; z0 = 0.6;
tip = [q(1), L1*cos(q(2)) + L2*cos(q(2)+q(3)), z0 + L1*sin(q(2)) + L2*sin(q(2)+q(3))];
end

function d = inletDir(V, pose)
